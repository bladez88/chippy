DATABASE_URL=postgresql://chippy:chippy@localhost:5432/chippy

# Google Identity Services (sign-in). Use the same web client ID in apps/web/.env.
GOOGLE_CLIENT_ID=
JWT_SECRET=replace-with-at-least-32-characters

# Current development routing uses the deterministic mock. ORS is the planned
# non-Google route provider; its key must remain server-side.
OPENROUTESERVICE_API_KEY=

# Reserved for a Google Maps migration. Never expose this server key to Vite.
GOOGLE_MAPS_SERVER_API_KEY=

CLIENT_URL=http://localhost:5173
API_PORT=3000
NODE_ENV=development
ENABLE_DEV_AUTH=true
ROUTING_PROVIDER=mock
